#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);




class Motor {
public:
  int EN, IN1, IN2;

  Motor(int en, int in1, int in2) {
    EN = en;
    IN1 = in1;
    IN2 = in2;
  }

  void begin() {
    pinMode(EN, OUTPUT);
    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);
  }

  void forward(int speed) {
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    analogWrite(EN, speed);
  }

  void backward(int speed) {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    analogWrite(EN, speed);
  }

  void stop() {
    analogWrite(EN, 0);
  }
};

// ROBOT CLASS
class Robot {
public:
  Motor left;
  Motor right;

  Robot(Motor l, Motor r) : left(l), right(r) {}

  void begin() {
    left.begin();
    right.begin();
  }

  void forward(int speed) {
    left.forward(speed);
    right.forward(speed);
  }

  void backward(int speed) {
    left.backward(speed);
    right.backward(speed);
  }

  // Differential turning
  void leftTurn(int speed) {
    left.forward(speed / 2);
    right.forward(speed);
  }

  void rightTurn(int speed) {
    left.forward(speed);
    right.forward(speed / 2);
  }

  void stop() {
    left.stop();
    right.stop();
  }
};


Motor leftMotor(5, 6, 7);

Motor rightMotor(9, 10, 11);

Robot robot(leftMotor, rightMotor);
 

// Buttons
const int FWD = 2;
const int BWD = 3;
const int LT  = 4;
const int RT  = 8;

// Potentiometer
const int POT = A0;

// Ultrasonic
const int TRIG = A1;
const int ECHO = A2;




void setup() {

  robot.begin();

  // Buttons
  pinMode(FWD, INPUT_PULLUP);
  pinMode(BWD, INPUT_PULLUP);
  pinMode(LT, INPUT_PULLUP);
  pinMode(RT, INPUT_PULLUP);

  // Ultrasonic
  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);

  // LCD
  lcd.init();
  lcd.backlight();

  lcd.print("ROBOT CART");
  lcd.setCursor(0, 1);
  lcd.print("READY");

  delay(1500);
  lcd.clear();
}


//  ULTRASONIC DISTANCE FUNCTION

int getDistance() {

  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG, LOW);

  long time = pulseIn(ECHO, HIGH, 30000);

  return time * 0.034 / 2;
}


//  MAIN LOOP 

void loop() {

  // Read potentiometer and set speed
  int speed = map(analogRead(POT), 0, 1023, 0, 255);

  
  int speedPercent = map(speed, 0, 255, 0, 100);

  
  int distance = getDistance();


  //  OBSTACLE CHECK 

  if (distance > 0 && distance < 15) {

    robot.stop();

    lcd.setCursor(0, 0);
    lcd.print("!! WARNING !!   ");

    lcd.setCursor(0, 1);
    lcd.print("DIST: ");
    lcd.print(distance);
    lcd.print(" cm     ");
  }


  //  CONTROL 

  else {

    // Forward
    if (digitalRead(FWD) == LOW) {

      robot.forward(speed);

      lcd.setCursor(0, 0);
      lcd.print("FORWARD         ");
    }

    // Backward
    else if (digitalRead(BWD) == LOW) {

      robot.backward(speed);

      lcd.setCursor(0, 0);
      lcd.print("BACKWARD        ");
    }

    // Left
    else if (digitalRead(LT) == LOW) {

      robot.leftTurn(speed);

      lcd.setCursor(0, 0);
      lcd.print("LEFT            ");
    }

    // Right
    else if (digitalRead(RT) == LOW) {

      robot.rightTurn(speed);

      lcd.setCursor(0, 0);
      lcd.print("RIGHT           ");
    }

    // No button
    else {

      robot.stop();

      lcd.setCursor(0, 0);
      lcd.print("STOPPED         ");
    }


    // Display speed and distance
    lcd.setCursor(0, 1);
    lcd.print("SPD:");
    lcd.print(speedPercent);
    lcd.print("% D:");
    lcd.print(distance);
    lcd.print("cm ");
  }

  delay(100);
}
